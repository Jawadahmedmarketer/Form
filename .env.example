NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_WORKFLOW_WEBHOOK_URL=
GHL_SIGNED_AGREEMENT_CUSTOM_FIELD_ID=
# Optional text custom field for the raw signing URL on the contact.
GHL_AGREEMENT_LINK_FIELD_ID=

# Private Integration Token with Invoices scope, plus the GHL user that "sends" invoices.
GHL_INVOICE_API_TOKEN=
GHL_INVOICE_USER_ID=

GHL_CF_AGREEMENT_STATUS=
GHL_CF_AGREEMENT_SIGNED_DATE=
GHL_CF_AGREEMENT_TYPE=
GHL_CF_SELECTED_SERVICES=
GHL_CF_SETUP_FEE=
GHL_CF_MONTHLY_FEE=
# Optional — if empty, the app matches GHL fields named
# "Authorized Representative Name/Title" and "Company Authorization Date".
GHL_CF_REPRESENTATIVE_NAME=
GHL_CF_REPRESENTATIVE_TITLE=
GHL_CF_REPRESENTATIVE_DATE=

# Public site origin used to build unique agreement links.
# Local: http://localhost:3000
# Production: the live domain, e.g. https://form-personal-d1fb.vercel.app or https://agreements.unifiedtaxgroup.com
# If this is missing in production, links fall back to localhost — set it on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_API_SECRET=
PAYMENT_URL=

RESEND_API_KEY=
EMAIL_FROM=Unified Tax Group <info@unifiedtaxgroup.com>
